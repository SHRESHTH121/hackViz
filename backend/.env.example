# PostgreSQL connection (psycopg 3 driver). PostgreSQL is mandatory - there is no SQLite fallback.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/hackviz

# Local Ollama (must be a localhost address)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=240

# Automatic analysis: run when an employee has this many new live events...
ANALYSIS_BATCH_SIZE=5
# ...or when new live events have been idle for this many seconds
ANALYSIS_IDLE_SECONDS=90
# Wait this long before retrying after a failed analysis (events are NOT skipped)
ANALYSIS_RETRY_SECONDS=60
# Max events sent to the model per analysis
ANALYSIS_MAX_RECENT_EVENTS=35
# Set to false to disable the background analysis worker (Analyze Now still works)
ANALYSIS_AUTO_ENABLED=true

# Organisation timezone offset in minutes (IST = 330), used for working-hours context
ORG_UTC_OFFSET_MINUTES=330

# Allowed browser origins for the dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
